{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "拾光本地桌面窗口权限",
  "windows": ["main", "capture-*", "pin-*"],
  "permissions": [
    "core:default", "core:window:allow-start-dragging", "core:window:allow-start-resize-dragging",
    "core:window:allow-hide", "core:window:allow-show", "core:window:allow-set-focus",
    "core:window:allow-minimize", "core:window:allow-set-always-on-top",
    "core:window:allow-set-size", "core:window:allow-set-position", "dialog:allow-open"
  ]
}
