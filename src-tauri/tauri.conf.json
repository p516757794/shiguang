{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拾光",
  "version": "0.1.2",
  "identifier": "app.shiguang.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "拾光",
        "width": 900,
        "height": 660,
        "minWidth": 340,
        "minHeight": 420,
        "decorations": false,
        "resizable": true,
        "alwaysOnTop": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "useLocalToolsDir": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "license": "AGPL-3.0-only",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../components/COMPONENT-NOTICES.md": "COMPONENT-NOTICES.md"
    },
    "homepage": "https://github.com/p516757794/shiguang",
    "shortDescription": "剪贴板、截图贴图、识字与离线文档转换",
    "longDescription": "拾光是一款 Windows 桌面效率工具，提供剪贴板历史、收藏短语、截图贴图、文字识别及按需下载组件的本地 Word/PDF 转换。"
  }
}
